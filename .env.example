POSTGRES_USER=cyber
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cyberevents
DATABASE_URL=postgres://cyber:change_me@db:5432/cyberevents
JWT_SECRET=change_me_long_random_string
APP_MODE=vuln
BIND_IP=192.168.56.104
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=cyberadmin

# --- Email réel (optionnel) : si vide -> email écrit dans logs/emails.log ---
# Gmail : crée un "mot de passe d'application" (compte Google -> Sécurité)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- WhatsApp via Twilio (optionnel) : si vide -> message écrit dans logs/whatsapp.log ---
# Twilio -> Messaging -> Try WhatsApp (sandbox). Le FROM est le numéro du sandbox.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Numéro SMS Twilio (capable d'envoyer des SMS), ex : +15551234567 -> 2FA par SMS
TWILIO_SMS_FROM=
# Numéro WhatsApp qui reçoit les billets en démo (ton numéro, format international)
DEMO_WHATSAPP_TO=whatsapp:+33XXXXXXXXX
# URL publique de l'API (Render) pour joindre l'image du QR au message WhatsApp.
# Laisser vide en local -> le message WhatsApp sera en texte seulement.
PUBLIC_BASE_URL=
